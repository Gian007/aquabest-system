{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AquaBest Demonstration Dataset Schema",
  "type": "object",
  "required": [
    "metadata",
    "demo_as_of",
    "business",
    "employees",
    "customers",
    "products",
    "orders",
    "order_items",
    "payments",
    "expenses",
    "inventory",
    "inventory_movements",
    "container_movements",
    "trips",
    "delivery_stops",
    "notifications",
    "operational_settings"
  ],
  "properties": {
    "metadata": {
      "type": "object",
      "required": ["name", "version", "synthetic", "timezone", "coverage"],
      "properties": {
        "name": { "type": "string" },
        "version": { "type": "string" },
        "synthetic": { "const": true },
        "timezone": { "const": "Asia/Manila" },
        "coverage": {
          "type": "object",
          "required": ["start", "end"],
          "properties": {
            "start": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
            "end": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
          }
        }
      }
    },
    "demo_as_of": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "employees": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": ["id", "name", "role", "active"],
        "properties": {
          "role": { "enum": ["Super Admin", "Manager", "Staff / Operations"] }
        }
      }
    },
    "orders": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "customer", "source", "service", "status", "paymentStatus", "amount", "date", "items"],
        "properties": {
          "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "amount": { "type": "number", "minimum": 0 }
        }
      }
    },
    "expenses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "date", "category", "description", "amount", "paymentStatus", "active"],
        "properties": {
          "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "amount": { "type": "number", "exclusiveMinimum": 0 },
          "active": { "type": "boolean" }
        }
      }
    },
    "inventory": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "openingQuantity", "quantity", "minimum"]
      }
    },
    "inventory_movements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "productId", "type", "quantity", "reason"]
      }
    },
    "container_movements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "product_id", "quantity", "movement_type"]
      }
    }
  }
}
